<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <ViewFlipper
        android:id="@+id/bg_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="14000"
        android:inAnimation="@anim/w_bg_in"
        android:outAnimation="@anim/w_bg_out" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <ViewFlipper
            android:id="@+id/marker_flipper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:autoStart="true"
            android:flipInterval="14000"
            android:inAnimation="@anim/w_in_0"
            android:outAnimation="@anim/w_out" />
        <ViewFlipper
            android:id="@+id/counter_flipper"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:autoStart="true"
            android:flipInterval="14000"
            android:inAnimation="@anim/w_in_0"
            android:outAnimation="@anim/w_out" />
        </RelativeLayout>
        <ViewFlipper
            android:id="@+id/title_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp" android:layout_weight="1"
            android:autoStart="true"
            android:flipInterval="14000"
            android:inAnimation="@anim/w_in_1"
            android:outAnimation="@anim/w_out" />
        <ViewFlipper
            android:id="@+id/status_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="76dp"
            android:autoStart="true"
            android:flipInterval="14000"
            android:inAnimation="@anim/w_in_2"
            android:outAnimation="@anim/w_out" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tap_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|start"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="All clear."
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Nothing needs you today."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <include layout="@layout/widget_flip_buttons" />
</FrameLayout>