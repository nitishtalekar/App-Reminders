<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg_birthday" />
            <stroke android:width="1dp" android:color="@color/line_birthday" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item
        android:width="130dp"
        android:height="130dp"
        android:top="1dp"
        android:right="1dp"
        android:gravity="top|end"
        android:drawable="@drawable/pattern_dots" />
</layer-list>
